# Token da @BotFather
TELEGRAM_BOT_TOKEN=

# Orario dell'invio giornaliero e fuso in cui interpretarlo
SEND_AT=09:00
TZ_NAME=Europe/Copenhagen

# Salta l'invio nei giorni in cui la mensa è chiusa (default: true)
SKIP_WEEKEND=true

# File SQLite con iscritti e cache delle traduzioni
DB_PATH=matkant.sqlite

# --- Traduzione danese → italiano ---
# google | deepl | mymemory | none   (default: mymemory, o google/deepl se c'è la chiave)
TRANSLATE_PROVIDER=mymemory

# Google Cloud Translation v2
# GOOGLE_TRANSLATE_API_KEY=

# DeepL (le chiavi del piano free finiscono con ":fx")
# DEEPL_API_KEY=

# MyMemory: dichiarare un'email alza la quota da 5k a 50k caratteri/giorno
# MYMEMORY_EMAIL=

# Mostra l'originale danese accanto alla traduzione (default: true)
SHOW_ORIGINAL=true
